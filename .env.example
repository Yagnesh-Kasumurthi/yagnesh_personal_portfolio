# Resend API Key for sending transactional emails (from https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key

# Destination recipient email where visitor contact messages should be delivered
CONTACT_EMAIL=your_email@example.com

# Verified sender email address configured in Resend (defaults to onboarding@resend.dev during testing)
EMAIL_FROM=Portfolio <onboarding@resend.dev>
